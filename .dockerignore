# Keep the build context to what the image build reads. That includes tools/ (the build
# generates THIRD_PARTY_NOTICES with it) and the root LICENSE and NOTICE (they ship in the image).
.git
.github
.superpowers
.DS_Store
**/node_modules
**/dist
**/.build
**/coverage
**/*.tsbuildinfo
.env
.env.*
!.env.example
playwright-report
test-results
docs
deploy
docker-compose.test.yml
Dockerfile
.dockerignore
